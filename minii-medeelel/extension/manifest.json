{
  "manifest_version": 3,
  "name": "Миний мэдээлэл AI — e-Mongolia",
  "version": "0.1.0",
  "description": "e-Mongolia-д нэвтэрсэн үед ЭМД, НДШ, торгууль зэрэг мэдээллээ нэг дор харж, өмнөх сартай харьцуулж, AI-аар хураангуйлна.",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://e-mongolia.mn/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Миний мэдээлэл AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
