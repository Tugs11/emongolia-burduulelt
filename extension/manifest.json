{
  "manifest_version": 3,
  "name": "Бүрдүүлэлт AI — e-Mongolia PoC",
  "version": "0.1.0",
  "description": "Жагсаалтаа оруулахад нэвтэрсэн e-Mongolia-оос лавлагааг автоматаар татаж, нэг хавтсанд цуглуулна.",
  "permissions": ["sidePanel", "tabs", "scripting", "downloads", "storage"],
  "host_permissions": ["https://e-mongolia.mn/*", "https://*.e-mongolia.mn/*", "https://*.workers.dev/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Бүрдүүлэлт AI" }
}
